# ==============================================================================
# HOSTAFRICA / cPanel Setup Node.js App - Environment Variables Template (SA)
# ==============================================================================
# Add these key-value pairs into the "Environment variables" section of
# cPanel > Software > Setup Node.js App > Edit Application
# ==============================================================================

# Application Runtime Mode & SAST Timezone
NODE_ENV=production
PORT=5000
DATA_RESIDENCY_REGION=za-jhb
ENFORCE_LOCAL_RESIDENCY=true
DEFAULT_TIMEZONE=Africa/Johannesburg

# PostgreSQL Database Configuration (HOSTAFRICA Local / PgBouncer)
DB_HOST=localhost
DB_PORT=5432
DB_USER=cpaneluser_shogun
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=cpaneluser_shogundb
DB_SCHEMA=public
DB_SSL=true
DB_PGBOUNCER=true
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=30

# Prisma Database Connection URL (PgBouncer Transaction Pooling + Strict SSL)
DATABASE_URL="postgresql://cpaneluser_shogun:YourStrongDatabasePassword123!@localhost:5432/cpaneluser_shogundb?schema=public&pgbouncer=true&statement_cache_size=0&sslmode=require&sslaccept=strict&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://cpaneluser_shogun:YourStrongDatabasePassword123!@localhost:5432/cpaneluser_shogundb?schema=public&sslmode=require&sslaccept=strict"

# Background Workers & Redis (Set ENABLE_WORKERS=true only if Redis is provisioned)
ENABLE_WORKERS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=true

# South African S3-Compatible Object Storage (HOSTAFRICA / AWS af-south-1)
S3_REGION=za-jhb
S3_ENDPOINT=https://s3.za-jhb.hostafrica.co.za
S3_BUCKET=shogun-za-vault
S3_ACCESS_KEY_ID=your_sa_access_key
S3_SECRET_ACCESS_KEY=your_sa_secret_key
S3_FORCE_PATH_STYLE=true

# Outbound Email / SMTP Notifications
SMTP_FROM="Shogun Notifications <notifications@yourdomain.co.za>"

# JWT Authentication Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=f9a8e27c10b4d53890123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=7d

# cPanel Cron Secret (Must match the X-Cron-Secret header in cPanel Cron manager)
CRON_SECRET=shogun_cron_task_secret_998877

# Frontend Client Origin (CORS Whitelist for public_html)
CLIENT_ORIGIN=https://yourdomain.co.za
