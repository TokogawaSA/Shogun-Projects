# ==============================================================================
# cPanel Setup Node.js App - Environment Variables Template
# ==============================================================================
# Add these key-value pairs into the "Environment variables" section of
# cPanel > Software > Setup Node.js App > Edit Application
# ==============================================================================

# Application Runtime Mode
NODE_ENV=production

# Server Port (Passenger dynamically assigns its internal port/socket, but 5000 is default fallback)
PORT=5000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=cpaneluser_shogun
DB_PASSWORD=YourStrongDatabasePassword123!
DB_NAME=cpaneluser_shogundb
DB_SCHEMA=public

# Prisma Database Connection URL (Constructed from above credentials)
DATABASE_URL="postgresql://cpaneluser_shogun:YourStrongDatabasePassword123!@localhost:5432/cpaneluser_shogundb?schema=public&connection_limit=10"

# JWT Authentication Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=f9a8e27c10b4d53890123456789abcdef0123456789abcdef0123456789abcdef
JWT_EXPIRES_IN=7d

# cPanel Cron Secret (Must match the X-Cron-Secret header in cPanel Cron manager)
CRON_SECRET=shogun_cron_task_secret_998877

# Frontend Client Origin (CORS Whitelist for public_html)
CLIENT_ORIGIN=https://yourdomain.com
