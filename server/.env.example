# ==========================================
# 1. Server Configuration
# ==========================================
PORT=5000
NODE_ENV=development
ENABLE_WORKERS=false

# ==========================================
# 2. Database Configuration (Local PostgreSQL or Supabase)
# ==========================================
# Option A: Local PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shogun_db?schema=public&connection_limit=10&pool_timeout=30"

# Option B: Supabase (Transaction Pooler - Port 6543)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string (NodeJS / URI) -> Mode: Transaction
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=10&pool_timeout=30"

# Supabase Direct Connection (Session Mode - Port 5432 - Required for Prisma Migrations)
# Get from: Supabase Dashboard -> Project Settings -> Database -> Connection string (NodeJS / URI) -> Mode: Session
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# ==========================================
# 3. JWT Authentication & Security
# ==========================================
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars_min
JWT_EXPIRES_IN=7d

# ==========================================
# 4. CORS Allowed Origins
# ==========================================
# Comma-separated list of allowed frontend URLs
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==========================================
# 5. Cron & Background Workers (BullMQ / Redis)
# ==========================================
CRON_SECRET=shogun_cron_task_secret_change_in_production
# Optional: Redis connection for BullMQ workers & Socket.io horizontal adapter
# REDIS_URL=redis://localhost:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ==========================================
# 6. Outbound Email / SMTP Notifications
# ==========================================
SMTP_FROM="Shogun Notifications <notifications@shogun.io>"


