# ==========================================
# 1. Server & South African POPIA Residency
# ==========================================
PORT=5000
NODE_ENV=development
ENABLE_WORKERS=false

# POPIA Section 72 Data Residency Controls ('za-jhb' | 'za-cpt' | 'af-south-1' | 'southafricanorth')
DATA_RESIDENCY_REGION=za-jhb
ENFORCE_LOCAL_RESIDENCY=true
DEFAULT_TIMEZONE=Africa/Johannesburg

# ==========================================
# 2. Database Configuration (Local SA PostgreSQL 16+ or AWS af-south-1)
# ==========================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shogun_db
DB_SCHEMA=public
DB_SSL=false
DB_PGBOUNCER=true
DB_CONNECTION_LIMIT=10
DB_POOL_TIMEOUT=30

# Option A: Local PostgreSQL / PgBouncer Transaction Pooler
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shogun_db?schema=public&pgbouncer=true&statement_cache_size=0&connection_limit=10&pool_timeout=30"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/shogun_db?schema=public"

# Option B: AWS Cape Town (af-south-1) / Supabase SA Pooler (Port 6543 Transaction Mode)
# DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-af-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&statement_cache_size=0&sslmode=require&sslaccept=strict&connection_limit=10&pool_timeout=30"
# DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-af-south-1.pooler.supabase.com:5432/postgres?sslmode=require&sslaccept=strict"

# ==========================================
# 3. JWT Authentication & Security
# ==========================================
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars_min
JWT_EXPIRES_IN=7d

# ==========================================
# 4. CORS Allowed Origins
# ==========================================
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# ==========================================
# 5. Cron & Background Workers (BullMQ / Redis)
# ==========================================
CRON_SECRET=shogun_cron_task_secret_change_in_production
# REDIS_URL=rediss://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ==========================================
# 6. South African Tenant-Isolated Object Storage (S3-Compatible)
# ==========================================
S3_REGION=af-south-1
# Optional custom endpoint for HOSTAFRICA Object Storage (e.g. https://s3.za-jhb.hostafrica.co.za)
# S3_ENDPOINT=https://s3.af-south-1.amazonaws.com
S3_BUCKET=shogun-za-vault
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# ==========================================
# 7. South African Payment Rails (Peach Payments Checkout V2)
# ==========================================
PEACH_ENV=sandbox
PEACH_ENTITY_ID=
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_WEBHOOK_SECRET=
PEACH_MERCHANT_ID=
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:5000

# ==========================================
# 8. Outbound Email / SMTP Notifications
# ==========================================
SMTP_FROM="Shogun Notifications <notifications@shogun.co.za>"
