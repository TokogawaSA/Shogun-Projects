# Server Configuration
PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=shogun_db
DB_SCHEMA=public

# Prisma Database Connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&connection_limit=10&pool_timeout=30
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/shogun_db?schema=public&connection_limit=10&pool_timeout=30"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_32chars_min
JWT_EXPIRES_IN=7d

# CORS Allowed Origins
CORS_ORIGIN=http://localhost:5173
