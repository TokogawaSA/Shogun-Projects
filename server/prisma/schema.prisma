  id                 String    @id @default(cuid())
  tenantId           String
  bookingTypeId      String?
  hostUserId         String
  title              String
  description        String?   @db.Text
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  status             String    @default("scheduled") // scheduled | confirmed | completed | cancelled | rescheduled | no_show
  locationType       String    @default("google_meet")
  locationUrl        String?

  // Guest Details
  guestName          String
  guestEmail         String
  guestPhone         String?
  guestNotes         String?   @db.Text
  customAnswers      Json?

  // Linked CRM & Project Entities (Activity Linkage)
  projectId          String?
  accountId          String?
  contactId          String?
  dealId             String?

  cancellationReason String?
  rescheduledFromId  String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  hostUser           User          @relation("BookingHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  bookingType        BookingType?  @relation(fields: [bookingTypeId], references: [id], onDelete: SetNull)
  project            Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  account            Account?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact            Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal               Deal?         @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, startTime])
  @@index([hostUserId])
  @@index([startTime])
  @@index([projectId])
  @@index([contactId])
  @@index([accountId])
  @@index([guestEmail])
  @@map("bookings")
}

// ==========================================
// 18. POPIA Governance Engine (South Africa Act 4 of 2013)
// ==========================================

model PopiaConsentRecord {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  subjectType String    // 'contact' | 'lead' | 'account' | 'user'
  subjectId   String
  purpose     String    // 'crm_processing' | 'marketing' | 'ai_mcp_processing' | 'cross_border_sync'
  lawfulBasis String    // 'consent' | 'contract' | 'legitimate_interest' | 'legal_obligation'
  granted     Boolean   @default(true)
  capturedAt  DateTime  @default(now())
  withdrawnAt DateTime?
  sourceIp    String?
  evidenceUrl String?

  @@index([tenantId])
  @@index([tenantId, subjectType, subjectId])
  @@index([tenantId, purpose])
  @@map("popia_consent_records")
}

model PopiaRetentionPolicy {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  moduleName     String   // 'leads' | 'contacts' | 'accounts' | 'deals' | 'audit_logs'
  retentionDays  Int      @default(1095)
  actionOnExpiry String   @default("anonymize") // 'anonymize' | 'hard_delete'
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, moduleName])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("popia_retention_policies")
}

model PopiaAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @db.Uuid
  actorUserId    String?
  actorAgent     String   @default("human") // 'human' | 'Sentinel' | 'Worker' | 'Auditor'
  action         String   // 'READ_PII' | 'EXPORT_PII' | 'ANONYMIZE' | 'DELETE' | 'CONSENT_CHANGE'
  entityType     String
  entityId       String
  fieldsAccessed Json     @db.JsonB
  ipAddress      String?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, action])
  @@map("popia_audit_logs")
}

// ==========================================
// 19. South African Working Calendar & Statutory Public Holidays (Act 36 of 1994)
// ==========================================

model WorkingCalendar {
  id             String   @id @default(cuid())
  tenantId       String?
  name           String   @default("South Africa Standard (SAST)")
  countryCode    String   @default("ZA")
  workDays       Int[]    @default([1, 2, 3, 4, 5]) // ISO / JS Mon=1 .. Fri=5
  dailyWorkHours Decimal  @default(8.00) @db.Decimal(5, 2)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  holidays       PublicHoliday[]
  projects       Project[]

  @@index([tenantId])
  @@index([countryCode, isDefault])
  @@map("working_calendars")
}

model PublicHoliday {
  id               String          @id @default(cuid())
  calendarId       String
  date             DateTime        @db.Date
  name             String
  isObservedMonday Boolean         @default(false)
  isAdHocDeclared  Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  calendar         WorkingCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@unique([calendarId, date])
  @@index([calendarId, date])
  @@map("public_holidays")
}





