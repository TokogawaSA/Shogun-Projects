// ==========================================
// 15. Organic Social Engagement & Listening
// ==========================================

model SocialListeningRule {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  keywords      Json     // string[] - keywords/phrases to track
  excludedWords Json?    // string[] - negative exclude-words
  platforms     Json     // string[] - ['twitter', 'linkedin', 'facebook', 'instagram', 'reddit', 'youtube']
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interactions  SocialInteraction[]

  @@index([tenantId])
  @@index([isActive])
  @@map("social_listening_rules")
}

model SocialInteraction {
  id              String    @id @default(cuid())
  tenantId        String
  ruleId          String?
  platform        String    // twitter | linkedin | facebook | instagram | reddit | youtube
  externalId      String?
  authorName      String
  authorHandle    String
  authorAvatar    String?
  isVerified      Boolean   @default(false)
  content         String    @db.Text
  mediaUrls       Json?     // string[]
  sentiment       String    @default("neutral") // positive | neutral | negative
  sentimentScore  Float?    @default(0.0)
  intent          String    @default("general") // support_issue | purchase_intent | praise | general
  urgency         String    @default("low")     // low | medium | high | critical
  status          String    @default("new")     // new | in_progress | replied | escalated | resolved | ignored
  threadHistory   Json?     // Array<{ id: string, author: string, handle: string, content: string, timestamp: string, isOutbound: boolean }>
  escalatedTaskId String?
  linkedContactId String?
  linkedAccountId String?
  linkedDealId    String?
  postUrl         String?
  publishedAt     DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rule            SocialListeningRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  escalatedTask   Task?               @relation("SocialEscalatedTask", fields: [escalatedTaskId], references: [id], onDelete: SetNull)
  linkedContact   Contact?            @relation("SocialLinkedContact", fields: [linkedContactId], references: [id], onDelete: SetNull)
  linkedAccount   Account?            @relation("SocialLinkedAccount", fields: [linkedAccountId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, publishedAt])
  @@index([tenantId, status])
  @@index([platform])
  @@index([sentiment])
  @@index([intent])
  @@index([status])
  @@index([escalatedTaskId])
  @@index([linkedContactId])
  @@index([linkedAccountId])
  @@map("social_interactions")
}

