// Prisma Schema for Shogun Projects - Multi-Tenant Relational PostgreSQL Backend
// Target: PostgreSQL 16+ (Consolidated PostgreSQL + Express + Redis Stack)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. Auth & Multi-Tenancy
// ==========================================

model Tenant {
  id          String   @id @default(cuid())
  name        String
  domain      String?  @unique
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  users             User[]
  profiles          Profile[]
  roles             Role[]
  projects          Project[]
  tasks             Task[]
  projectMilestones ProjectMilestone[]
  deliverables      ProjectDeliverable[]
  leads             Lead[]
  accounts          Account[]
  contacts          Contact[]
  deals             Deal[]
  activityLogs      EntityActivityLog[]
  productsOrServices ProductOrService[]
  priceBooks        PriceBook[]
  quotes            Quote[]
  projectBudgets    ProjectBudget[]
  expenseEntries    ExpenseEntry[]
  portfolios        Portfolio[]
  resourceProfiles  ResourceProfile[]
  riskItems         RiskItem[]
  auditTrails       AuditTrailEntry[]
  systemConfig      SystemConfig?
  moduleSchemas     ModuleSchema[]
  workflowRules     WorkflowRule[]
  emailConfig       EmailConfig?
  emailTemplates    EmailTemplate[]
  timesheets        Timesheet[]
  invoices          ProjectInvoice[]
  taxInvoices       TaxInvoice[]
  paymentTransactions PaymentTransaction[]
  accountingConnections TenantAccountingConnection[]
  workingCalendars  WorkingCalendar[]
  documents         ProjectDocument[]
  wikiPages         ProjectWikiPage[]
  changeRequests    ClientChangeRequest[]
  socialListeningRules SocialListeningRule[]
  socialInteractions   SocialInteraction[]
  bookingTypes         BookingType[]
  userAvailabilities   UserAvailability[]
  bookings             Booking[]

  @@map("tenants")
}

model User {
  id            String   @id @default(cuid())
  tenantId      String
  email         String   @unique
  passwordHash  String
  displayName   String
  photoURL      String?
  role          String   @default("developer") // admin | project_manager | developer | viewer
  isTenantAdmin Boolean  @default(false)
  profileId     String?
  roleId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign keys & Relations
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile       Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  roleHierarchy Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Domain associations
  ownedProjects     Project[]          @relation("ProjectOwner")
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  timeLogs          TimeLog[]
  resourceProfile   ResourceProfile?
  assignedLeads     Lead[]             @relation("LeadAssignee")
  createdLeads      Lead[]             @relation("LeadCreator")
  assignedAccounts  Account[]          @relation("AccountAssignee")
  createdAccounts   Account[]          @relation("AccountCreator")
  assignedContacts  Contact[]          @relation("ContactAssignee")
  createdContacts   Contact[]          @relation("ContactCreator")
  assignedDeals     Deal[]             @relation("DealAssignee")
  createdDeals      Deal[]             @relation("DealCreator")
  ownedRisks        RiskItem[]         @relation("RiskOwner")
  ownedPortfolios   Portfolio[]        @relation("PortfolioOwner")
  timesheets        Timesheet[]        @relation("TimesheetUser")
  approvedTimesheets Timesheet[]       @relation("TimesheetApprover")
  uploadedDocuments ProjectDocument[]  @relation("DocumentUploader")
  authoredWikiPages ProjectWikiPage[]  @relation("WikiAuthor")
  bookingTypes      BookingType[]
  availability      UserAvailability?
  hostedBookings    Booking[]          @relation("BookingHost")

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Profile {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String?  @db.Text
  modulePermissions Json     // Record<ModuleName, ModuleCrudPermissions>
  fieldPermissions  Json     // Record<ModuleName, Record<FieldName, FieldPermissionLevel>>
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  roles             Role[]

  @@index([tenantId])
  @@map("profiles")
}

model Role {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String?  @db.Text
  parentRoleId      String?
  assignedProfileId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentRole        Role?    @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles        Role[]   @relation("RoleHierarchy")
  profile           Profile? @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  users             User[]

  @@index([tenantId])
  @@map("roles")
}

// ==========================================
// 2. Projects & Tasks
// ==========================================

model Project {
  id               String   @id @default(cuid())
  tenantId         String
  title            String
  description      String?  @db.Text
  organizationId   String?
  ownerId          String
  members          Json?    // Array of user IDs
  accountId        String?
  dealId           String?
  primaryContactId String?
  portfolioId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner            User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  deal             Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  primaryContact   Contact?          @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  portfolio        Portfolio?        @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  code             String?
  calendarId       String?
  estimatedCost    Decimal?          @db.Decimal(14, 2)
  targetMultiplier Decimal           @default(3.0) @db.Decimal(4, 2)

  workingCalendar  WorkingCalendar?  @relation(fields: [calendarId], references: [id], onDelete: SetNull)

  tasks            Task[]
  milestones       ProjectMilestone[]
  deliverables     ProjectDeliverable[]
  budget           ProjectBudget?
  expenses         ExpenseEntry[]
  risks            RiskItem[]
  quotes           Quote[]
  invoices         ProjectInvoice[]
  taxInvoices      TaxInvoice[]
  documents        ProjectDocument[]
  wikiPages        ProjectWikiPage[]
  changeRequests   ClientChangeRequest[]
  bookings         Booking[]

  // AEC Architectural Extensions
  phases           ProjectPhase[]
  drawingSheets    DrawingSheet[]
  rfis             Rfi[]
  submittals       Submittal[]
  siteReports      SiteReport[]
  subConsultants   SubConsultantLedger[]

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@index([ownerId])
  @@index([accountId])
  @@index([dealId])
  @@map("projects")
}

model ProjectMilestone {
  id                   String   @id @default(cuid())
  projectId            String
  tenantId             String
  title                String
  dueDate              DateTime?
  status               String   @default("pending") // pending | in_progress | completed
  completionPercentage Float    @default(0)
  description          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks                Task[]
  deliverables         ProjectDeliverable[]

  @@index([projectId])
  @@index([tenantId])
  @@map("project_milestones")
}

model Task {
  id                 String    @id @default(cuid())
  projectId          String
  tenantId           String
  title              String
  description        String?   @db.Text
  status             String    @default("todo") // todo | in_progress | review | done
  priority           String    @default("medium") // low | medium | high | urgent
  category           String?
  assignedAgent      String?   // Sentinel | Worker | Auditor | Human | None
  progress           Float     @default(0)
  assigneeId         String?
  creatorId          String
  dueDate            DateTime?
  parentTaskId       String?
  milestoneId        String?
  lineItemId         String?
  estimatedHours     Float     @default(0)
  actualHours        Float     @default(0)
  isRecurring        Boolean   @default(false)
  recurrenceRule     String?   // daily | weekly | monthly
  predecessorTaskIds Json?     // string[]
  relatedEntityType  String?   // project | deal | account | contact
  relatedEntityId    String?
  customFields       Json?
  attachments        Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee           User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator            User              @relation("TaskCreator", fields: [creatorId], references: [id])
  parentTask         Task?             @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks           Task[]            @relation("TaskHierarchy")
  milestone          ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  lineItem           LineItem?         @relation(fields: [lineItemId], references: [id], onDelete: SetNull)

  checklistSubtasks  SubTask[]
  timeLogs           TimeLog[]

  // AEC Task Extensions
  discipline         String?   // Architectural | Structural | MEP | Civil | BIM
  requiredRole       String?   // Principal | Associate | Trainee | BIM Tech | Project Architect
  prerequisiteTaskId String?
  isGatekeeper       Boolean   @default(false)
  phaseId            String?
  projectPhase       ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  socialInteractions SocialInteraction[] @relation("SocialEscalatedTask")

  @@index([projectId])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@index([phaseId])
  @@map("tasks")
}

model SubTask {
  id           String    @id @default(cuid())
  taskId       String
  title        String
  description  String?   @db.Text
  completed    Boolean   @default(false)
  assigneeId   String?
  dueDate      DateTime?
  priority     String?   @default("medium")
  attachments  Json?
  customFields Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model TimeLog {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  userName    String?
  hoursLogged Float
  date        DateTime @default(now())
  description String?  @db.Text
  isBillable  Boolean  @default(true)
  hourlyRate  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  timesheetId String?
  timesheet   Timesheet? @relation(fields: [timesheetId], references: [id], onDelete: SetNull)

  // AEC Time Tracking Extensions
  phaseId          String?
  projectPhase     ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  phaseBillingCode String?       // e.g. "SD-101-MASSING"

  @@index([taskId])
  @@index([userId])
  @@index([phaseId])
  @@map("time_logs")
}

// ==========================================
// 3. CRM Entities
// ==========================================

model Lead {
  id                 String    @id @default(cuid())
  tenantId           String
  leadNumber         String
  salutation         String?
  firstName          String
  lastName           String
  company            String
  title              String?
  email              String
  secondaryEmail     String?
  phone              String?
  mobile             String?
  website            String?
  leadSource         String    @default("web_site")
  leadStatus         String    @default("unqualified")
  rating             String?
  industry           String?
  annualRevenue      Float?
  street             String?
  city               String?
  state              String?
  postalCode         String?
  country            String?
  description        String?   @db.Text
  assignedUserId     String
  createdById        String
  isConverted        Boolean   @default(false)
  convertedAccountId String?
  convertedContactId String?
  convertedDealId    String?
  convertedAt        DateTime?
  customFields       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser       User      @relation("LeadAssignee", fields: [assignedUserId], references: [id])
  createdBy          User      @relation("LeadCreator", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([assignedUserId])
  @@index([email])
  @@map("crm_leads")
}

model Account {
  id                 String    @id @default(cuid())
  tenantId           String
  accountNumber      String
  accountName        String
  domain             String?
  primaryPhone       String?
  secondaryPhone     String?
  email              String?
  website            String?
  industry           String    @default("Other")
  accountType        String    @default("prospect")
  rating             String    @default("warm")
  annualRevenue      Float?
  billingStreet      String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  description        String?   @db.Text

  // South African B2B Procurement & Statutory Firmographics
  cipcRegistrationNumber String?   // e.g. 2021/123456/07
  vatRegistrationNumber  String?   // 10-digit SARS VAT number starting with 4
  bbbeeLevel             Int?      // 1-8 Contributor Level, or 0 for Non-Compliant
  bbbeeExpiryDate        DateTime?
  csdSupplierNumber      String?   // National Treasury CSD e.g. MAAA0123456

  assignedUserId     String
  createdById        String
  customFields       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser       User      @relation("AccountAssignee", fields: [assignedUserId], references: [id])
  createdBy          User      @relation("AccountCreator", fields: [createdById], references: [id])

  contacts           Contact[]
  deals              Deal[]
  projects           Project[]
  quotes             Quote[]
  taxInvoices        TaxInvoice[]
  socialInteractions SocialInteraction[] @relation("SocialLinkedAccount")
  bookings           Booking[]

  @@index([tenantId])
  @@index([assignedUserId])
  @@index([tenantId, bbbeeExpiryDate])
  @@index([vatRegistrationNumber])
  @@index([cipcRegistrationNumber])
  @@map("crm_accounts")
}

model Contact {
  id                 String    @id @default(cuid())
  tenantId           String
  contactNumber      String
  salutation         String?
  firstName          String
  lastName           String
  accountId          String
  email              String
  secondaryEmail     String?
  phone              String?
  mobile             String?
  jobTitle           String?
  department         String?
  reportsToContactId String?
  mailingStreet      String?
  mailingCity        String?
  mailingState       String?
  mailingPostalCode  String?
  mailingCountry     String?
  isPrimaryContact   Boolean   @default(false)
  description        String?   @db.Text
  assignedUserId     String
  createdById        String
  customFields       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedUser       User      @relation("ContactAssignee", fields: [assignedUserId], references: [id])
  createdBy          User      @relation("ContactCreator", fields: [createdById], references: [id])
  reportsToContact   Contact?  @relation("ContactHierarchy", fields: [reportsToContactId], references: [id], onDelete: SetNull)
  subordinateContacts Contact[] @relation("ContactHierarchy")

  deals              Deal[]
  projects           Project[]
  quotes             Quote[]
  socialInteractions SocialInteraction[] @relation("SocialLinkedContact")
  bookings           Booking[]

  @@index([tenantId])
  @@index([accountId])
  @@index([assignedUserId])
  @@index([email])
  @@map("crm_contacts")
}

model Deal {
  id              String    @id @default(cuid())
  tenantId        String
  dealNumber      String
  dealName        String
  accountId       String
  contactId       String?
  amount          Float     @default(0)
  currency        String    @default("USD")
  closingDate     DateTime
  stage           String    @default("prospecting")
  probability     Float     @default(0)
  dealType        String    @default("new_business")
  leadSource      String?
  linkedProjectId String?
  lostReason      String?
  description     String?   @db.Text
  assignedUserId  String
  createdById     String
  customFields    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser    User      @relation("DealAssignee", fields: [assignedUserId], references: [id])
  createdBy       User      @relation("DealCreator", fields: [createdById], references: [id])

  projects        Project[]
  quotes          Quote[]
  bookings        Booking[]

  @@index([tenantId])
  @@index([tenantId, stage])
  @@index([tenantId, createdAt])
  @@index([accountId])
  @@index([contactId])
  @@index([assignedUserId])
  @@map("crm_deals")
}

model EntityActivityLog {
  id           String   @id @default(cuid())
  tenantId     String
  moduleName   String
  entityId     String
  action       String   // created | updated | deleted | converted | assigned | mass_updated
  userId       String
  userName     String?
  fieldChanges Json?
  description  String?  @db.Text
  timestamp    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, moduleName, entityId])
  @@index([tenantId, timestamp])
  @@index([moduleName, entityId])
  @@map("crm_entity_activity_logs")
}

// ==========================================
// 4. Catalog & Financials
// ==========================================

model ProductOrService {
  id               String   @id @default(cuid())
  tenantId         String
  type             String   @default("product") // product | service
  sku              String
  name             String
  description      String?  @db.Text
  unitPrice        Float    @default(0)
  costPrice        Float    @default(0)
  taxRatePercent   Float    @default(0)
  inventoryQty     Int      @default(0)
  reorderLevel     Int      @default(0)
  billingFrequency String?  // one_time | monthly | quarterly | annual
  isActive         Boolean  @default(true)
  category         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems        LineItem[]
  deliverables     ProjectDeliverable[]

  @@index([tenantId])
  @@index([sku])
  @@map("catalog_products_services")
}

model PriceBook {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  description       String?   @db.Text
  pricingRules      Json      // Record<productId, overridePrice>
  isDefault         Boolean   @default(false)

  // Multi-Currency & SARS 15% VAT Configuration
  currency          String    @default("ZAR")
  exchangeRateToZar Decimal   @default(1.000000) @db.Decimal(14, 6)
  rateLockedAt      DateTime?
  taxMode           String    @default("EXCLUSIVE") // 'EXCLUSIVE' | 'INCLUSIVE' | 'ZERO_RATED' | 'EXEMPT'
  vatRate           Decimal   @default(0.1500) @db.Decimal(6, 4)
  subtotalExclVat   Decimal   @default(0) @db.Decimal(14, 2)
  vatAmount         Decimal   @default(0) @db.Decimal(14, 2)
  totalInclVat      Decimal   @default(0) @db.Decimal(14, 2)

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes            Quote[]

  @@index([tenantId])
  @@map("catalog_price_books")
}

model Quote {
  id                String    @id @default(cuid())
  tenantId          String
  quoteNumber       String
  title             String
  dealId            String?
  accountId         String?
  contactId         String?
  projectId         String?
  priceBookId       String?
  status            String    @default("draft") // draft | presented | approved | rejected | converted
  subtotal          Float     @default(0)
  discountTotal     Float     @default(0)
  taxTotal          Float     @default(0)
  grandTotal        Float     @default(0)
  totalCost         Float     @default(0)
  marginAmount      Float     @default(0)
  marginPercent     Float     @default(0)

  // Multi-Currency & SARS 15% VAT Fields
  currency          String    @default("ZAR")
  exchangeRateToZar Decimal   @default(1.000000) @db.Decimal(14, 6)
  rateLockedAt      DateTime?
  taxMode           String    @default("EXCLUSIVE") // 'EXCLUSIVE' | 'INCLUSIVE' | 'ZERO_RATED' | 'EXEMPT'
  vatRate           Decimal   @default(0.1500) @db.Decimal(6, 4)
  subtotalExclVat   Decimal   @default(0) @db.Decimal(14, 2)
  vatAmount         Decimal   @default(0) @db.Decimal(14, 2)
  totalInclVat      Decimal   @default(0) @db.Decimal(14, 2)

  validUntil        DateTime?
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant            Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal              Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  account           Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact           Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  project           Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priceBook         PriceBook?   @relation(fields: [priceBookId], references: [id], onDelete: SetNull)

  lineItems         LineItem[]
  taxInvoices       TaxInvoice[]

  @@index([tenantId])
  @@index([quoteNumber])
  @@map("financial_quotes")
}

model TaxInvoice {
  id                         String    @id @default(cuid())
  tenantId                   String
  invoiceNumber              String    // e.g. INV-0001 via tenant auto-numbering
  accountId                  String?
  projectId                  String?
  quoteId                    String?
  status                     String    @default("DRAFT") // 'DRAFT' | 'ISSUED' | 'PARTIALLY_PAID' | 'PAID' | 'VOID'
  currency                   String    @default("ZAR")
  subtotalExclVat            Decimal   @default(0) @db.Decimal(14, 2)
  vatAmount                  Decimal   @default(0) @db.Decimal(14, 2)
  totalInclVat               Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid                 Decimal   @default(0) @db.Decimal(14, 2)
  dueDate                    DateTime
  externalAccountingProvider String?   // 'SAGE_ZA' | 'XERO' | null
  externalAccountingId       String?
  lastSyncedAt               DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  tenant                     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account                    Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
  project                    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  quote                      Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  paymentTransactions        PaymentTransaction[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([accountId])
  @@index([projectId])
  @@index([quoteId])
  @@map("tax_invoices")
}

model PaymentTransaction {
  id                    String    @id @default(cuid())
  tenantId              String
  taxInvoiceId          String
  provider              String    @default("PEACH_V2")
  checkoutId            String?
  merchantTransactionId String    @unique // Unique 8-16 char idempotency reference
  amount                Decimal   @db.Decimal(14, 2)
  currency              String    @default("ZAR")
  paymentMethod         String?   // 'CARD' | 'PAYSHAP' | 'CAPITECPAY' | 'PAYBYBANK'
  status                String    @default("PENDING") // 'PENDING' | 'SUCCEEDED' | 'FAILED' | 'CANCELLED'
  resultCode            String?
  registrationId        String?
  rawResponse           Json      @db.JsonB
