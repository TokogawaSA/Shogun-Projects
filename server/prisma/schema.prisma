// Prisma Schema for Shogun Projects - Multi-Tenant Relational PostgreSQL Backend
// Target: PostgreSQL 16+ (Consolidated PostgreSQL + Express + Redis Stack)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 1. Auth & Multi-Tenancy
// ==========================================

model Tenant {
  id          String   @id @default(cuid())
  name        String
  domain      String?  @unique
  industry    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relationships
  users             User[]
  profiles          Profile[]
  roles             Role[]
  projects          Project[]
  tasks             Task[]
  projectMilestones ProjectMilestone[]
  deliverables      ProjectDeliverable[]
  leads             Lead[]
  accounts          Account[]
  contacts          Contact[]
  deals             Deal[]
  activityLogs      EntityActivityLog[]
  productsOrServices ProductOrService[]
  priceBooks        PriceBook[]
  quotes            Quote[]
  projectBudgets    ProjectBudget[]
  expenseEntries    ExpenseEntry[]
  portfolios        Portfolio[]
  resourceProfiles  ResourceProfile[]
  riskItems         RiskItem[]
  auditTrails       AuditTrailEntry[]
  systemConfig      SystemConfig?
  moduleSchemas     ModuleSchema[]
  workflowRules     WorkflowRule[]
  emailConfig       EmailConfig?
  emailTemplates    EmailTemplate[]

  @@map("tenants")
}

model User {
  id            String   @id @default(cuid())
  tenantId      String
  email         String   @unique
  passwordHash  String
  displayName   String
  photoURL      String?
  role          String   @default("developer") // admin | project_manager | developer | viewer
  isTenantAdmin Boolean  @default(false)
  profileId     String?
  roleId        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Foreign keys & Relations
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile       Profile? @relation(fields: [profileId], references: [id], onDelete: SetNull)
  roleHierarchy Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)

  // Domain associations
  ownedProjects     Project[]          @relation("ProjectOwner")
  assignedTasks     Task[]             @relation("TaskAssignee")
  createdTasks      Task[]             @relation("TaskCreator")
  timeLogs          TimeLog[]
  resourceProfile   ResourceProfile?
  assignedLeads     Lead[]             @relation("LeadAssignee")
  createdLeads      Lead[]             @relation("LeadCreator")
  assignedAccounts  Account[]          @relation("AccountAssignee")
  createdAccounts   Account[]          @relation("AccountCreator")
  assignedContacts  Contact[]          @relation("ContactAssignee")
  createdContacts   Contact[]          @relation("ContactCreator")
  assignedDeals     Deal[]             @relation("DealAssignee")
  createdDeals      Deal[]             @relation("DealCreator")
  ownedRisks        RiskItem[]         @relation("RiskOwner")
  ownedPortfolios   Portfolio[]        @relation("PortfolioOwner")

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

model Profile {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String?  @db.Text
  modulePermissions Json     // Record<ModuleName, ModuleCrudPermissions>
  fieldPermissions  Json     // Record<ModuleName, Record<FieldName, FieldPermissionLevel>>
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             User[]
  roles             Role[]

  @@index([tenantId])
  @@map("profiles")
}

model Role {
  id                String   @id @default(cuid())
  tenantId          String
  name              String
  description       String?  @db.Text
  parentRoleId      String?
  assignedProfileId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentRole        Role?    @relation("RoleHierarchy", fields: [parentRoleId], references: [id], onDelete: SetNull)
  childRoles        Role[]   @relation("RoleHierarchy")
  profile           Profile? @relation(fields: [assignedProfileId], references: [id], onDelete: SetNull)
  users             User[]

  @@index([tenantId])
  @@map("roles")
}

// ==========================================
// 2. Projects & Tasks
// ==========================================

model Project {
  id               String   @id @default(cuid())
  tenantId         String
  title            String
  description      String?  @db.Text
  organizationId   String?
  ownerId          String
  members          Json?    // Array of user IDs
  accountId        String?
  dealId           String?
  primaryContactId String?
  portfolioId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner            User              @relation("ProjectOwner", fields: [ownerId], references: [id])
  account          Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  deal             Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  primaryContact   Contact?          @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  portfolio        Portfolio?        @relation(fields: [portfolioId], references: [id], onDelete: SetNull)

  tasks            Task[]
  milestones       ProjectMilestone[]
  deliverables     ProjectDeliverable[]
  budget           ProjectBudget?
  expenses         ExpenseEntry[]
  risks            RiskItem[]
  quotes           Quote[]

  @@index([tenantId])
  @@index([ownerId])
  @@index([accountId])
  @@index([dealId])
  @@map("projects")
}

model ProjectMilestone {
  id                   String   @id @default(cuid())
  projectId            String
  tenantId             String
  title                String
  dueDate              DateTime?
  status               String   @default("pending") // pending | in_progress | completed
  completionPercentage Float    @default(0)
  description          String?  @db.Text
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tasks                Task[]
  deliverables         ProjectDeliverable[]

  @@index([projectId])
  @@index([tenantId])
  @@map("project_milestones")
}

model Task {
  id                 String    @id @default(cuid())
  projectId          String
  tenantId           String
  title              String
  description        String?   @db.Text
  status             String    @default("todo") // todo | in_progress | review | done
  priority           String    @default("medium") // low | medium | high | urgent
  category           String?
  assignedAgent      String?   // Sentinel | Worker | Auditor | Human | None
  progress           Float     @default(0)
  assigneeId         String?
  creatorId          String
  dueDate            DateTime?
  parentTaskId       String?
  milestoneId        String?
  lineItemId         String?
  estimatedHours     Float     @default(0)
  actualHours        Float     @default(0)
  isRecurring        Boolean   @default(false)
  recurrenceRule     String?   // daily | weekly | monthly
  predecessorTaskIds Json?     // string[]
  relatedEntityType  String?   // project | deal | account | contact
  relatedEntityId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignee           User?             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator            User              @relation("TaskCreator", fields: [creatorId], references: [id])
  parentTask         Task?             @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subtasks           Task[]            @relation("TaskHierarchy")
  milestone          ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  lineItem           LineItem?         @relation(fields: [lineItemId], references: [id], onDelete: SetNull)

  checklistSubtasks  SubTask[]
  timeLogs           TimeLog[]

  @@index([projectId])
  @@index([tenantId])
  @@index([assigneeId])
  @@index([parentTaskId])
  @@index([milestoneId])
  @@map("tasks")
}

model SubTask {
  id         String   @id @default(cuid())
  taskId     String
  title      String
  completed  Boolean  @default(false)
  assigneeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@map("subtasks")
}

model TimeLog {
  id          String   @id @default(cuid())
  taskId      String
  userId      String
  userName    String?
  hoursLogged Float
  date        DateTime @default(now())
  description String?  @db.Text
  isBillable  Boolean  @default(true)
  hourlyRate  Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
  @@map("time_logs")
}

// ==========================================
// 3. CRM Entities
// ==========================================

model Lead {
  id                 String    @id @default(cuid())
  tenantId           String
  leadNumber         String
  salutation         String?
  firstName          String
  lastName           String
  company            String
  title              String?
  email              String
  secondaryEmail     String?
  phone              String?
  mobile             String?
  website            String?
  leadSource         String    @default("web_site")
  leadStatus         String    @default("unqualified")
  rating             String?
  industry           String?
  annualRevenue      Float?
  street             String?
  city               String?
  state              String?
  postalCode         String?
  country            String?
  description        String?   @db.Text
  assignedUserId     String
  createdById        String
  isConverted        Boolean   @default(false)
  convertedAccountId String?
  convertedContactId String?
  convertedDealId    String?
  convertedAt        DateTime?
  customFields       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser       User      @relation("LeadAssignee", fields: [assignedUserId], references: [id])
  createdBy          User      @relation("LeadCreator", fields: [createdById], references: [id])

  @@index([tenantId])
  @@index([assignedUserId])
  @@index([email])
  @@map("crm_leads")
}

model Account {
  id                 String    @id @default(cuid())
  tenantId           String
  accountNumber      String
  accountName        String
  domain             String?
  primaryPhone       String?
  secondaryPhone     String?
  email              String?
  website            String?
  industry           String    @default("Other")
  accountType        String    @default("prospect")
  rating             String    @default("warm")
  annualRevenue      Float?
  billingStreet      String?
  billingCity        String?
  billingState       String?
  billingPostalCode  String?
  billingCountry     String?
  shippingStreet     String?
  shippingCity       String?
  shippingState      String?
  shippingPostalCode String?
  shippingCountry    String?
  description        String?   @db.Text
  assignedUserId     String
  createdById        String
  customFields       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedUser       User      @relation("AccountAssignee", fields: [assignedUserId], references: [id])
  createdBy          User      @relation("AccountCreator", fields: [createdById], references: [id])

  contacts           Contact[]
  deals              Deal[]
  projects           Project[]
  quotes             Quote[]

  @@index([tenantId])
  @@index([assignedUserId])
  @@map("crm_accounts")
}

model Contact {
  id                 String    @id @default(cuid())
  tenantId           String
  contactNumber      String
  salutation         String?
  firstName          String
  lastName           String
  accountId          String
  email              String
  secondaryEmail     String?
  phone              String?
  mobile             String?
  jobTitle           String?
  department         String?
  reportsToContactId String?
  mailingStreet      String?
  mailingCity        String?
  mailingState       String?
  mailingPostalCode  String?
  mailingCountry     String?
  isPrimaryContact   Boolean   @default(false)
  description        String?   @db.Text
  assignedUserId     String
  createdById        String
  customFields       Json?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedUser       User      @relation("ContactAssignee", fields: [assignedUserId], references: [id])
  createdBy          User      @relation("ContactCreator", fields: [createdById], references: [id])
  reportsToContact   Contact?  @relation("ContactHierarchy", fields: [reportsToContactId], references: [id], onDelete: SetNull)
  subordinateContacts Contact[] @relation("ContactHierarchy")

  deals              Deal[]
  projects           Project[]
  quotes             Quote[]

  @@index([tenantId])
  @@index([accountId])
  @@index([assignedUserId])
  @@index([email])
  @@map("crm_contacts")
}

model Deal {
  id              String    @id @default(cuid())
  tenantId        String
  dealNumber      String
  dealName        String
  accountId       String
  contactId       String?
  amount          Float     @default(0)
  currency        String    @default("USD")
  closingDate     DateTime
  stage           String    @default("prospecting")
  probability     Float     @default(0)
  dealType        String    @default("new_business")
  leadSource      String?
  linkedProjectId String?
  lostReason      String?
  description     String?   @db.Text
  assignedUserId  String
  createdById     String
  customFields    Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact         Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  assignedUser    User      @relation("DealAssignee", fields: [assignedUserId], references: [id])
  createdBy       User      @relation("DealCreator", fields: [createdById], references: [id])

  projects        Project[]
  quotes          Quote[]

  @@index([tenantId])
  @@index([accountId])
  @@index([contactId])
  @@index([assignedUserId])
  @@map("crm_deals")
}

model EntityActivityLog {
  id           String   @id @default(cuid())
  tenantId     String
  moduleName   String
  entityId     String
  action       String   // created | updated | deleted | converted | assigned | mass_updated
  userId       String
  userName     String?
  fieldChanges Json?
  description  String?  @db.Text
  timestamp    DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([moduleName, entityId])
  @@map("crm_entity_activity_logs")
}

// ==========================================
// 4. Catalog & Financials
// ==========================================

model ProductOrService {
  id               String   @id @default(cuid())
  tenantId         String
  type             String   @default("product") // product | service
  sku              String
  name             String
  description      String?  @db.Text
  unitPrice        Float    @default(0)
  costPrice        Float    @default(0)
  taxRatePercent   Float    @default(0)
  inventoryQty     Int      @default(0)
  reorderLevel     Int      @default(0)
  billingFrequency String?  // one_time | monthly | quarterly | annual
  isActive         Boolean  @default(true)
  category         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItems        LineItem[]
  deliverables     ProjectDeliverable[]

  @@index([tenantId])
  @@index([sku])
  @@map("catalog_products_services")
}

model PriceBook {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  description  String?  @db.Text
  pricingRules Json     // Record<productId, overridePrice>
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotes       Quote[]

  @@index([tenantId])
  @@map("catalog_price_books")
}

model Quote {
  id            String    @id @default(cuid())
  tenantId      String
  quoteNumber   String
  title         String
  dealId        String?
  accountId     String?
  contactId     String?
  projectId     String?
  priceBookId   String?
  status        String    @default("draft") // draft | presented | approved | rejected | converted
  subtotal      Float     @default(0)
  discountTotal Float     @default(0)
  taxTotal      Float     @default(0)
  grandTotal    Float     @default(0)
  totalCost     Float     @default(0)
  marginAmount  Float     @default(0)
  marginPercent Float     @default(0)
  validUntil    DateTime?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deal          Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  account       Account?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contact       Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  project       Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  priceBook     PriceBook? @relation(fields: [priceBookId], references: [id], onDelete: SetNull)

  lineItems     LineItem[]

  @@index([tenantId])
  @@index([quoteNumber])
  @@map("financial_quotes")
}

model LineItem {
  id             String            @id @default(cuid())
  quoteId        String?
  productId      String?
  productName    String
  type           String            @default("product") // product | service
  quantity       Float             @default(1)
  unitPrice      Float             @default(0)
  costPrice      Float             @default(0)
  discountAmount Float             @default(0)
  taxAmount      Float             @default(0)
  taxRatePercent Float             @default(0)
  totalPrice     Float             @default(0)
  notes          String?           @db.Text

  quote          Quote?            @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product        ProductOrService? @relation(fields: [productId], references: [id], onDelete: SetNull)

  tasks          Task[]
  deliverables   ProjectDeliverable[]

  @@index([quoteId])
  @@index([productId])
  @@map("financial_line_items")
}

model ProjectDeliverable {
  id                 String            @id @default(cuid())
  projectId          String
  tenantId           String
  title              String
  type               String            @default("service")
  lineItemId         String?
  productId          String?
  sku                String?
  milestoneId        String?
  estimatedCost      Float             @default(0)
  billableAmount     Float             @default(0)
  profitMarginAmount Float             @default(0)
  profitMarginPercent Float            @default(0)
  status             String            @default("planned") // planned | in_progress | delivered | accepted
  fulfilledDate      DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineItem           LineItem?         @relation(fields: [lineItemId], references: [id], onDelete: SetNull)
  product            ProductOrService? @relation(fields: [productId], references: [id], onDelete: SetNull)
  milestone          ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([tenantId])
  @@map("financial_deliverables")
}

model ProjectBudget {
  id                  String   @id @default(cuid())
  projectId           String   @unique
  tenantId            String
  capexBudget         Float    @default(0)
  opexBudget          Float    @default(0)
  laborBudget         Float    @default(0)
  actualLaborCost     Float    @default(0)
  actualExpenses      Float    @default(0)
  currency            String   @default("USD")
  profitMarginPercent Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("financial_project_budgets")
}

model ExpenseEntry {
  id           String   @id @default(cuid())
  projectId    String
  tenantId     String
  category     String   @default("labor") // labor | software | hardware | travel | other
  amount       Float    @default(0)
  incurredDate DateTime @default(now())
  approvedBy   String?
  status       String   @default("pending") // pending | approved | rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([tenantId])
  @@map("financial_expense_entries")
}

// ==========================================
// 5. PPM & Risks
// ==========================================

model Portfolio {
  id              String    @id @default(cuid())
  tenantId        String
  name            String
  description     String?   @db.Text
  strategicGoal   String
  budgetAllocated Float     @default(0)
  targetROI       Float?
  ownerId         String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner           User      @relation("PortfolioOwner", fields: [ownerId], references: [id])
  projects        Project[]

  @@index([tenantId])
  @@index([ownerId])
  @@map("ppm_portfolios")
}

model ResourceProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  tenantId            String
  department          String
  skills              Json     // string[]
  weeklyCapacityHours Float    @default(40)
  hourlyCostRate      Float    @default(0)
  hourlyBillingRate   Float    @default(0)
  globalWorkloadHours Json?    // Record<string, number>
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("ppm_resource_profiles")
}

model RiskItem {
  id                     String   @id @default(cuid())
  projectId              String
  tenantId               String
  title                  String
  description            String?  @db.Text
  category               String   @default("operational") // financial | operational | technical | schedule | compliance
  probability            Int      @default(1) // 1-5
  impact                 Int      @default(1) // 1-5
  riskScore              Int      @default(1) // prob * impact
  mitigationPlan         String?  @db.Text
  departmentDependencies Json?    // string[]
  status                 String   @default("open") // open | mitigated | closed
  ownerId                String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  owner                  User     @relation("RiskOwner", fields: [ownerId], references: [id])

  @@index([projectId])
  @@index([tenantId])
  @@index([ownerId])
  @@map("ppm_risk_items")
}

model AuditTrailEntry {
  id            String   @id @default(cuid())
  tenantId      String
  entityType    String
  entityId      String
  action        String
  performedBy   String
  description   String?  @db.Text
  previousState Json?
  newState      Json?
  timestamp     DateTime @default(now())

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([entityType, entityId])
  @@map("system_audit_trail")
}

// ==========================================
// 6. Workflows & Settings
// ==========================================

model SystemConfig {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  companyDetails Json     // CompanyDetails: name, domain, timezone, currency, fiscalYearStart
  activeModules  Json     // ActiveModules map
  autoNumbering  Json     // AutoNumberingConfig map
  updatedAt      DateTime @updatedAt
  updatedBy      String?

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("settings_system_config")
}

model ModuleSchema {
  id         String        @id @default(cuid())
  tenantId   String
  moduleName String        // projects | tasks | accounts | contacts | deals | etc.
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  blocks     LayoutBlock[]
  fields     CustomField[]

  @@unique([tenantId, moduleName])
  @@index([tenantId])
  @@map("settings_module_schemas")
}

model LayoutBlock {
  id           String        @id @default(cuid())
  schemaId     String
  blockId      String
  label        String
  sortOrder    Int           @default(0)
  isCollapsible Boolean      @default(true)

  schema       ModuleSchema  @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  fields       CustomField[]

  @@index([schemaId])
  @@map("settings_layout_blocks")
}

model CustomField {
  id             String        @id @default(cuid())
  schemaId       String
  blockId        String?
  fieldId        String
  label          String
  type           String        // text | number | picklist | date | boolean | user | currency
  isRequired     Boolean       @default(false)
  isUnique       Boolean       @default(false)
  picklistValues Json?         // string[] | PicklistOption[]
  defaultValue   Json?
  sortOrder      Int           @default(0)

  schema         ModuleSchema  @relation(fields: [schemaId], references: [id], onDelete: Cascade)
  block          LayoutBlock?  @relation(fields: [blockId], references: [id], onDelete: SetNull)

  @@index([schemaId])
  @@index([blockId])
  @@map("settings_custom_fields")
}

model WorkflowRule {
  id           String   @id @default(cuid())
  tenantId     String
  title        String
  description  String?  @db.Text
  targetModule String   // ModuleName
  triggerType  String   // on_create | on_update | on_stage_change | time_based_cron
  conditions   Json     // WorkflowCondition[]
  actions      Json     // WorkflowAction[]
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("settings_workflow_rules")
}

model EmailConfig {
  id           String   @id @default(cuid())
  tenantId     String   @unique
  provider     String   @default("smtp") // smtp | sendgrid | mailgun
  fromEmail    String?
  senderEmail  String?
  fromName     String?
  senderName   String?
  apiKey       String?
  domain       String?
  smtpSettings Json?    // SmtpSettings: host, port, secure, username, password, encryption
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("settings_email_configs")
}

model EmailTemplate {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  module       String?
  targetModule String?
  subject      String
  bodyHtml     String?  @db.Text
  htmlBody     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  updatedBy    String?

  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("settings_email_templates")
}
