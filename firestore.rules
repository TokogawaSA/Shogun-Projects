rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Authenticated user check
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Tenant membership check
    function isTenantMember(tenantId) {
      return isAuthenticated() && (
        request.auth.token.tenantId == tenantId ||
        request.auth.token.role == 'admin'
      );
    }

    // Helper: Tenant Admin check
    function isTenantAdmin(tenantId) {
      return isTenantMember(tenantId) && (
        request.auth.token.isTenantAdmin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Helper: Check tenant isolation for legacy/root collections
    function isTenantAuthorized(data) {
      return isAuthenticated() && (
        !('tenantId' in data) ||
        !('tenantId' in request.auth.token) ||
        request.auth.token.tenantId == data.tenantId
      );
    }

    // Helper: Check authorized CRM role
    function hasCrmRole() {
      return isAuthenticated() && (
        !('role' in request.auth.token) ||
        request.auth.token.role in ['admin', 'manager', 'sales_rep', 'project_manager', 'developer']
      );
    }

    // Helper: Check if user belongs to project's members array or is the project owner
    function isProjectMember(projectId) {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/projects/$(projectId)) &&
          (
            ('members' in get(/databases/$(database)/documents/projects/$(projectId)).data &&
             request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.members) ||
            ('memberIds' in get(/databases/$(database)/documents/projects/$(projectId)).data &&
             request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.memberIds) ||
            get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId == request.auth.uid
          )
        )
      );
    }

    // =========================================================================
    // Multi-Tenant Isolated Workspace & Settings Tree: /tenants/{tenantId}/
    // =========================================================================
    match /tenants/{tenantId} {
      allow read: if isTenantMember(tenantId);
      allow write: if isTenantAdmin(tenantId);

      // System Configuration
      match /config/{document=**} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      // Workflow Rules & Triggers
      match /workflows/{workflowId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      // Module Schemas & Custom Fields
      match /module_schemas/{moduleName} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      // Roles & Hierarchy
      match /roles/{roleId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      // Profiles & Permission Sets
      match /profiles/{profileId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      // Email Gateway & Provider Settings (Private/Restricted to Admins Only)
      match /email_config/{configId} {
        allow read, write: if isTenantAdmin(tenantId);
      }

      // Email Notification Templates
      match /templates/{templateId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId);
      }

      // Tenant Users Collection
      match /users/{userId} {
        allow read: if isTenantMember(tenantId);
        allow write: if isTenantAdmin(tenantId) || (isTenantMember(tenantId) && request.auth.uid == userId);
      }
    }

    // =========================================================================
    // Root Level Collections (CRM, Projects & Global Profiles)
    // =========================================================================

    // Multi-tenant Project documents
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        ('members' in resource.data && request.auth.uid in resource.data.members) ||
        ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds) ||
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid ||
        ('members' in request.resource.data && request.auth.uid in request.resource.data.members)
      );
      allow update, delete: if isAuthenticated() && (
        ('members' in resource.data && request.auth.uid in resource.data.members) ||
        resource.data.ownerId == request.auth.uid
      );

      // Tasks Subcollection: Access strictly isolated to project members
      match /tasks/{taskId} {
        allow read, write: if isProjectMember(projectId);
      }

      // Activity Logs Subcollection: Read-only for project members; writes reserved exclusively for serverless triggers
      match /activity_logs/{logId} {
        allow read: if isProjectMember(projectId);
        allow write: if false; // Only Cloud Functions Admin SDK can write
      }
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // CRM: Accounts Collection (Multi-tenant & Role Enforced)
    match /accounts/{accountId} {
      allow read: if isAuthenticated() && isTenantAuthorized(resource.data);
      allow create: if isAuthenticated() && hasCrmRole() && isTenantAuthorized(request.resource.data);
      allow update, delete: if isAuthenticated() && hasCrmRole() && isTenantAuthorized(resource.data);
    }

    // CRM: Contacts Collection (Multi-tenant & Role Enforced)
    match /contacts/{contactId} {
      allow read: if isAuthenticated() && isTenantAuthorized(resource.data);
      allow create: if isAuthenticated() && hasCrmRole() && isTenantAuthorized(request.resource.data);
      allow update, delete: if isAuthenticated() && hasCrmRole() && isTenantAuthorized(resource.data);
    }

    // CRM: Deals Pipeline Collection (Multi-tenant & Role Enforced)
    match /deals/{dealId} {
      allow read: if isAuthenticated() && isTenantAuthorized(resource.data);
      allow create: if isAuthenticated() && hasCrmRole() && isTenantAuthorized(request.resource.data);
      allow update, delete: if isAuthenticated() && hasCrmRole() && isTenantAuthorized(resource.data);
    }

    // CRM: Leads Collection
    match /leads/{leadId} {
      allow read, write: if isAuthenticated();
    }

    // CRM: Organizations Collection
    match /organizations/{orgId} {
      allow read, write: if isAuthenticated();
    }

    // Global Audit Logs Collection
    match /audit_logs/{auditId} {
      allow read: if isAuthenticated();
      allow write: if false; // Server-side triggers only
    }
  }
}
